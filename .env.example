# 플랜 A: 집 컴퓨터 서버 + Cloudflare Tunnel
# QR코드에 들어갈 방문객용 주소 (Cloudflare Tunnel에 연결한 도메인)
YS_PUBLIC_URL=https://booth.example.com
# Cloudflare 대시보드 → Zero Trust → Networks → Tunnels → 터널 만들기 → 토큰 복사
# 터널의 Public Hostname 서비스 주소는 http://booth:8080 으로 지정
TUNNEL_TOKEN=
# 부스 기기용 열쇠. 길고 무작위로 (예: python3 -c "import secrets; print(secrets.token_urlsafe(16))")
YS_BOOTH_KEY=
# 사진 보관 시간(시간). 축제 뒤에도 받을 수 있게 기본 7일
YS_KEEP_HOURS=168
YS_BEAUTY=1
