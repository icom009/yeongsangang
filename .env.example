# 플랜 A: 집 컴퓨터 서버 + 인터넷 https 주소 (A-1 Cloudflare Tunnel 또는 A-2 포트포워딩 + Caddy)
# QR코드에 들어갈 방문객용 주소
YS_PUBLIC_URL=https://booth.example.com
# A-2(Caddy)용: 인증서를 받을 도메인 (YS_PUBLIC_URL의 호스트와 같게)
YS_DOMAIN=booth.example.com
# A-1(터널)용:
# Cloudflare 대시보드 → Zero Trust → Networks → Tunnels → 터널 만들기 → 토큰 복사
# 터널의 Public Hostname 서비스 주소는 http://booth:8080 으로 지정
TUNNEL_TOKEN=
# 부스 기기용 열쇠. 길고 무작위로 (예: python3 -c "import secrets; print(secrets.token_urlsafe(16))")
YS_BOOTH_KEY=
# 1이면 공개 주소에서도 키 없이 촬영 화면을 연다 (누구나 촬영·합성 가능)
YS_OPEN=
# 사진 보관 시간(시간). 축제 뒤에도 받을 수 있게 기본 7일
YS_KEEP_HOURS=168
YS_BEAUTY=1

# 생성형 AI 빛 보정(선택). auto면 로컬 IC-Light(docker-compose.ai.yml) → 아래 키 → 끔 순으로 자동
YS_AI=auto
# 외부 이미지 편집 API를 쓸 때만. 넣으면 얼굴 사진이 바깥 서버로 나가고 부스에 안내 문구가 뜬다
YS_AI_KEY=

# 관리 화면(/manage) 비밀번호. 공개 주소에서도 열리므로 꼭 바꿔 쓸 것
YS_MANAGE_KEY=ysg2026!
# 관리 화면에서 사진을 메일로 다시 보낼 때만 필요 (Gmail은 2단계 인증 뒤 '앱 비밀번호')
YS_SMTP_HOST=
YS_SMTP_PORT=587
YS_SMTP_USER=
YS_SMTP_PASS=
YS_SMTP_FROM=
